        <groupId>io.papermc.paper</groupId>
        <artifactId>paper-api</artifactId>
        <version>1.21.8-R0.1-SNAPSHOT</version>
        <scope>provided</scope>
    </dependency>
    <dependency>
	    <groupId>io.github.alvinnorin</groupId>
	    <artifactId>steinerhomes</artifactId>
	    <version>0.0.1-SNAPSHOT</version>
	    <scope>system</scope>
    <systemPath>/home/alvin/.m2/repository/SteinerHomes/SteinerHomes/0.0.1-SNAPSHOT/SteinerHomes-0.0.1-SNAPSHOT.jar</systemPath>
    </dependency>
